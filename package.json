{
  "name": "linter-stylelint-pulsar",
  "version": "5.0.0",
  "private": true,
  "description": "A plugin for Atom/Pulsar Linter providing an interface to stylelint.",
  "main": "lib/index.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexrudd2/linter-stylelint"
  },
  "engines": {
    "atom": ">=1.7.0 <2.0.0"
  },
  "scripts": {
    "test": "APM_TEST_PACKAGES='linter-stylelint-pulsar language-postcss' pulsar --test spec",
    "lint": "biome lint .",
    "prepare": "husky install"
  },
  "keywords": [
    "css",
    "lint",
    "postcss",
    "stylelint"
  ],
  "author": {
    "name": "1000ch",
    "email": "shogo.sensui@gmail.com",
    "url": "http://github.com/1000ch"
  },
  "contributors": [
    "Alex Ruddick <alex@ruddick.tech> (https://github.com/alexrudd2)"
  ],
  "maintainers": [
    "Alex Ruddick <alex@ruddick.tech> (https://github.com/alexrudd2)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/alexrudd2/linter-stylelint/issues"
  },
  "configSchema": {
    "noConfigBehavior": {
      "title": "When no config is found",
      "description": "What to do with a file for which stylelint finds no configuration.",
      "type": "string",
      "default": "skip",
      "enum": [
        {
          "value": "standard",
          "description": "Lint with stylelint-config-standard"
        },
        {
          "value": "skip",
          "description": "Don't lint the file"
        },
        {
          "value": "warn",
          "description": "Don't lint, and show a one-time warning"
        }
      ],
      "order": 1
    },
    "showIgnored": {
      "title": "Show message when a file is ignored",
      "type": "boolean",
      "default": false,
      "order": 2
    },
    "fixOnSave": {
      "description": "Automatically attempt to fix errors using stylelint --fix flag (experimental)",
      "title": "Attempt to fix styles on save",
      "type": "boolean",
      "default": false,
      "order": 3
    }
  },
  "homepage": "https://github.com/alexrudd2/linter-stylelint#readme",
  "dependencies": {
    "assign-deep": "1.0.1",
    "postcss-less": "^7.0.0",
    "postcss-scss": "4.0.9",
    "resolve": "1.22.13",
    "stylelint": "^17.8.0",
    "stylelint-config-standard": "^40.0.0",
    "sugarss": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@stylistic/stylelint-plugin": "^5.1.0",
    "@types/jasmine": "^7.0.0",
    "atom-jasmine2-test-runner": "^2.99.1",
    "husky": "9.1.7",
    "rimraf": "^6.0.0"
  },
  "package-deps": [
    {
      "name": "linter",
      "minimumVersion": "3.4.0"
    }
  ],
  "providedServices": {
    "linter": {
      "versions": {
        "2.0.0": "provideLinter"
      }
    }
  },
  "renovate": {
    "extends": [
      "config:recommended",
      ":preserveSemverRanges"
    ],
    "packageRules": [
      {
        "matchDepTypes": [
          "devDependencies"
        ],
        "automerge": true
      }
    ]
  },
  "atomTestRunner": "atom-jasmine2-test-runner"
}
